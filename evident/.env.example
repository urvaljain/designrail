# ── Required ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://evident:evident@127.0.0.1:5432/evident"
# Public origin of the app. Used for the CSRF origin check and OAuth redirects.
APP_URL="http://localhost:3000"

# ── AI (optional). With no key the app runs on its deterministic engine. ──
# LLM_PROVIDER: "none" | "anthropic" | "openai-compatible"
LLM_PROVIDER="none"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""
# Per-user monthly cap on LLM-backed agent runs (free / plus).
AI_RUNS_FREE="30"
AI_RUNS_PLUS="300"

# ── OAuth (optional). A provider's button appears only when both values are set. ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Job sources ─────────────────────────────────────────────────────────
# Comma-separated public job boards to sync: "<kind>:<board-token>[:Display Name]".
# Kinds: greenhouse, lever, ashby. Only add boards whose terms permit it.
JOB_SOURCES=""
# "true" loads the clearly-labelled synthetic demo board (fictional companies).
ENABLE_DEMO_SOURCE="true"
